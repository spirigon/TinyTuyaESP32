WIFI_SSID=your_wifi
WIFI_PASS=your_password

TUYA_DEVICE_ID=DEVICE_ID_HERE
TUYA_DEVICE_IP=192.168.1.42
TUYA_LOCAL_KEY=0123456789abcdef
TUYA_PROTOCOL_VERSION=3.4
TUYA_RELAY_DP=1

# HTTPS forwarding through Caddy. Keep the token and local CA file out of Git.
FORWARD_SERVER_URL=https://VPS_IP/tuya
FORWARD_TLS_HOSTNAME=esp32-receiver.invalid
FORWARD_TOKEN=replace_with_receiver_token
FORWARD_CA_CERT_FILE=certs/caddy-root-ca.crt
FORWARD_INTERVAL_MS=30000

# Optional extra devices for examples/multi_device.ino
# TUYA_DEVICE_ID_2=DEVICE_ID_2_HERE
# TUYA_DEVICE_IP_2=192.168.1.43
# TUYA_LOCAL_KEY_2=fedcba9876543210
# TUYA_PROTOCOL_VERSION_2=3.4
