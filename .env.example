WIFI_SSID=your_wifi
WIFI_PASS=your_password

TUYA_DEVICE_ID=DEVICE_ID_HERE
TUYA_DEVICE_IP=192.168.1.42
TUYA_LOCAL_KEY=0123456789abcdef
TUYA_PROTOCOL_VERSION=3.4
TUYA_RELAY_DP=1

# HTTPS forwarding through the public Caddy hostname. Keep the token out of Git.
FORWARD_SERVER_URL=https://148-253-213-23.sslip.io/tuya
FORWARD_TLS_HOSTNAME=148-253-213-23.sslip.io
FORWARD_GATEWAY_ID=esp32-6k
FORWARD_TOKEN=replace_with_unique_gateway_token
FORWARD_CA_CERT_FILE=certs/isrg-root-x1.pem
FORWARD_INTERVAL_MS=30000

# Optional extra devices (repeat the same four fields for suffixes 2 through 8).
# TUYA_DEVICE_ID_2=DEVICE_ID_2_HERE
# TUYA_DEVICE_IP_2=192.168.1.43
# TUYA_LOCAL_KEY_2=fedcba9876543210
# TUYA_PROTOCOL_VERSION_2=3.4
